{
  "info": {
    "_postman_id": "b25f516a-a215-4ae0-a23e-cc4a243b5797",
    "name": "PayPilot API",
    "description": "Smoke requests for the PayPilot FastAPI service. Set baseUrl to the API origin and apiPrefix to /api/v1. Protected PayPal connection checks need a Supabase access token. No secrets are stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "apiPrefix", "value": "/api/v1" },
    { "key": "supabaseAccessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}{{apiPrefix}}/health"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('API health responds successfully', () => pm.response.to.have.status(200));", "pm.test('Health response does not expose secret values', () => pm.expect(pm.response.text()).not.to.include('client_secret'));" ] } }]
    },
    {
      "name": "Assess commitment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currency\": \"USD\",\n  \"starting_cash\": 10000,\n  \"starting_cash_source\": \"owner_verified\",\n  \"required_reserve\": 1000,\n  \"cash_flows\": [\n    { \"date\": \"2026-12-01\", \"direction\": \"outflow\", \"amount\": 2500, \"label\": \"Rent\" },\n    { \"date\": \"2026-12-15\", \"direction\": \"inflow\", \"amount\": 4000, \"label\": \"Customer payment\" }\n  ]\n}"
        },
        "url": "{{baseUrl}}{{apiPrefix}}/commitments/assess"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Assessment returns a guarded scenario result', () => pm.response.to.have.status(200));", "pm.test('Assessment includes assumptions and scenario version', () => { const body = pm.response.json(); pm.expect(body.scenario_version).to.be.a('string'); pm.expect(body.assumptions).to.be.an('array'); });"] } }]
    },
    {
      "name": "Sponsor integration status",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}{{apiPrefix}}/integrations/status"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Sponsor status lists the integrations', () => { const body = pm.response.json(); pm.expect(body.integrations).to.be.an('array'); pm.expect(body.integrations.length).to.be.at.least(10); });"] } }]
    },
    {
      "name": "PayPal integration status",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}{{apiPrefix}}/integrations/paypal/status"
      }
    },
    {
      "name": "Check PayPal Sandbox credentials",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{supabaseAccessToken}}", "type": "string" }]
        },
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}{{apiPrefix}}/integrations/paypal/connection-check"
      }
    },
    {
      "name": "Channel3 product search (requires Supabase token and CHANNEL3_API_KEY)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{supabaseAccessToken}}", "type": "string" }]
        },
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}{{apiPrefix}}/integrations/channel3/search?query=office%20chair&limit=5"
      }
    },
    {
      "name": "Elastic evidence search (requires Supabase token and configured index)",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{supabaseAccessToken}}", "type": "string" }]
        },
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}{{apiPrefix}}/integrations/elastic/evidence-search?query=invoice"
      }
    },
    {
      "name": "Reject unauthenticated Channel3 product search",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}{{apiPrefix}}/integrations/channel3/search?query=office%20chair&limit=5"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('A caller without a Supabase session cannot access shared Channel3 credentials', () => pm.expect(pm.response.code).to.be.oneOf([401, 503]));"] } }]
    },
    {
      "name": "Reject unauthenticated Elastic evidence search",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}{{apiPrefix}}/integrations/elastic/evidence-search?query=invoice"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('A caller without a Supabase session cannot search another workspace', () => pm.expect(pm.response.code).to.be.oneOf([401, 503]));"] } }]
    },
    {
      "name": "Reject unsigned PayPal webhook replay",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"id\":\"POSTMAN-UNSIGNED-REPLAY\",\"event_type\":\"PAYMENT.CAPTURE.COMPLETED\",\"resource\":{\"id\":\"UNVERIFIED\"}}" },
        "url": "{{baseUrl}}{{apiPrefix}}/webhooks/paypal"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Unsigned webhook replay is rejected and never acknowledged', () => pm.expect(pm.response.code).to.be.oneOf([400, 503]));"] } }]
    }
  ]
}
