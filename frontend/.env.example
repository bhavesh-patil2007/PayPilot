# Browser-visible configuration only. Never place private keys or server credentials here.

# Optional API base URL for a manually-started local API; scripts/dev.sh overrides this.
# In production, set the deployed API URL at frontend build time.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase browser auth: set both values together. Use only a publishable key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
