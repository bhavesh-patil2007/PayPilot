# Copy to the repository-root .env. Backend credentials stay server-side.

# 1. Application configuration
# Optional; labels health responses and production diagnostics.
APP_ENV=development

# 2. Frontend/backend origins
# Optional for local development; set to the exact deployed frontend origin in production.
# The scripts/dev.sh launcher overrides this with its selected local frontend port.
CORS_ORIGINS=http://localhost:5173

# 3. Supabase (backend)
# Set both to enable Supabase Auth checks on protected backend endpoints.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Conditional: direct Postgres DSN for verified webhook storage, workspace membership lookup,
# and Elastic evidence search. The API can start without it; those features remain unavailable.
DATABASE_URL=

# 4. PayPal
# Optional; defaults to sandbox. Select live only when using the separate live credential variables.
PAYPAL_ENVIRONMENT=sandbox
# Optional endpoint override; must match PAYPAL_ENVIRONMENT exactly.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Sandbox client credentials only; paired and never exposed to the frontend.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Conditional: Sandbox webhook ID; requires the Sandbox client ID and secret.
PAYPAL_WEBHOOK_ID=
# Live credentials are separate so the Sandbox pair can never be reused by Live mode.
# Conditional pair; required to enable PayPal when PAYPAL_ENVIRONMENT=live.
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
# Conditional: Live webhook ID; requires the Live client ID and secret.
PAYPAL_LIVE_WEBHOOK_ID=

# 5. AI providers
# Selects/validates provider credentials only; no model client is currently called by PayPilot.
AI_PROVIDER=none
# Conditional: required when AI_PROVIDER=openai. Also used by local Supabase Studio if configured.
OPENAI_API_KEY=
# Conditional: required when AI_PROVIDER=gemini.
GEMINI_API_KEY=

# 6. Channel3
# Optional; enables live product search on the sponsor page. The API key remains server-side.
CHANNEL3_API_KEY=
# Optional override; code default is https://api.trychannel3.com.
CHANNEL3_BASE_URL=https://api.trychannel3.com

# 7. Elastic / Elasticsearch
# Set URL and key together for private evidence upload/indexing and authenticated, workspace-filtered search.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Optional; default index is paypilot-evidence.
ELASTICSEARCH_INDEX=paypilot-evidence

# 8. Astropods read-only investigator
# Requires both values. The deployed agent must be configured with read-only scoped PayPilot tools.
ASTROPODS_API_KEY=
ASTROPODS_DEPLOYMENT_ID=
ASTROPODS_READ_ONLY_CONFIRMED=false

# 9. KERNEL public evidence browser
# Optional server-only key. Browser retrieval is explicitly triggered by a signed-in user and is read-only.
KERNEL_API_KEY=
# Set true only after replacing the key with a newly rotated, scoped key.
KERNEL_KEY_ROTATED_AFTER_INCIDENT=false

# 10. Zapier MCP
# Endpoint and long-lived connection token are backend-only. No action runs until its tool name is allowlisted
# and the user approves it in the app. Keep this list empty until you have reviewed the connected actions.
ZAPIER_MCP_ENDPOINT=
ZAPIER_MCP_TOKEN=
ZAPIER_MCP_ALLOWED_TOOLS=

# 11. APIMatic
# The PayPal Server SDK is APIMatic-generated and used for typed OAuth by the backend adapter.
# Install the PayPal Context Plugin in VS Code with: npx context-plugins install paypal --targets vscode

# 12. Postman
# The exported collection runs without Postman's programmatic API; no API key is consumed.

# 13. Render Workflows
# The task code and Blueprint live in this repo. These are only needed to trigger hosted workflow runs.
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=

# 14. AG Grid, AG Studio, Bryntum
# AG Grid Community and trial AG Studio/Bryntum packages are used in the frontend.
# Do not commit vendor license keys; production use may require commercial licenses.

# 15. Background workers
# There is no worker or Redis-backed queue; REDIS_URL is not consumed by this application.

# 16. Storage
# Evidence originals use the private Supabase Storage bucket from the included migration;
# extracted document pages are indexed in Elastic with authenticated-workspace filtering.

# Local Supabase CLI-only optional providers/storage (not PayPilot runtime variables)
# Conditional: only when enabling the currently-disabled local Supabase Twilio SMS provider.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
# Conditional: only when enabling the currently-disabled local Supabase Apple OAuth provider.
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# Conditional: only when configuring the local Supabase experimental S3 storage backend.
S3_HOST=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
